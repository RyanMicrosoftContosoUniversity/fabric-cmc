      "seed": 101593331,
      "version": 191,
      "versionNonce": 1972391440,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1750170480233,
      "link": null,
      "locked": false,
      "text": "Cancel Dataset/SM Refresh - https://learn.microsoft.com/en-us/rest/api/power-bi/datasets/cancel-refresh-in-group\nScope: Dataset.ReadWrite.All\n\n\nStart Dataset/SM Refresh - https://learn.microsoft.com/en-us/rest/api/power-bi/datasets/refresh-dataset-in-group\nPOST https://api.powerbi.com/v1.0/myorg/groups/{groupId}/datasets/{datasetId}/refreshes\nScope: Dataset.ReadWrite.All\n\n\nGet Dataset/SM Refresh Info - GET https://api.powerbi.com/v1.0/myorg/groups/{groupId}/datasets/{datasetId}/refreshes\nhttps://learn.microsoft.com/en-us/rest/api/power-bi/datasets/get-refresh-history-in-group\nScope: Dataset.ReadWrite.All or Dataset.Read.All \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cancel Dataset/SM Refresh - https://learn.microsoft.com/en-us/rest/api/power-bi/datasets/cancel-refresh-in-group\nScope: Dataset.ReadWrite.All\n\n\nStart Dataset/SM Refresh - https://learn.microsoft.com/en-us/rest/api/power-bi/datasets/refresh-dataset-in-group\nPOST https://api.powerbi.com/v1.0/myorg/groups/{groupId}/datasets/{datasetId}/refreshes\nScope: Dataset.ReadWrite.All\n\n\nGet Dataset/SM Refresh Info - GET https://api.powerbi.com/v1.0/myorg/groups/{groupId}/datasets/{datasetId}/refreshes\nhttps://learn.microsoft.com/en-us/rest/api/power-bi/datasets/get-refresh-history-in-group\nScope: Dataset.ReadWrite.All or Dataset.Read.All \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
